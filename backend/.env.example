# ==========================================
# Soul of Médico AI - Environment Variables
# ==========================================

# Groq API Key — FREE at https://console.groq.com (no regional restrictions!)
GROQ_API_KEY=your-groq-api-key-here

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/soul_of_medico

# Server Port
PORT=5000

# Node Environment
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Session Cleanup Interval (hours) - auto-delete inactive sessions
SESSION_CLEANUP_HOURS=24

# Max messages per session
MAX_MESSAGES_PER_SESSION=50
